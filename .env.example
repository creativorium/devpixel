# Server-only. Add real values in Netlify Project configuration > Environment variables.
# Keep your actual values in .env.local (ignored by Git), never in this file.
RESEND_API_KEY=
# Create a Sending access key in Resend, scoped to notify.devnpixel.com.
# Verify notify.devnpixel.com in Resend before configuring this sender.
# CONTACT_FROM_EMAIL="DevnPixel <website@notify.devnpixel.com>"
# Messages go to code@devnpixel.com; Google Workspace remains the inbox provider.
CONTACT_FROM_EMAIL=

# Optional: private Google Sheets invoice register and short links. Server-only.
# Setup: GOOGLE-SHEETS-INVOICES.md. Never commit the downloaded service-account JSON.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Generate a random secret of at least 32 characters; enter it in the invoice tool.
INVOICE_OWNER_SECRET=
